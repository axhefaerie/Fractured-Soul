  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ey! la segunda reliquia.
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: va quedando menos para completar los pedidos y llegar al final de la
        cueva
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "si... pero los monstruos... me estan haciendo da\xF1o... y... estoy
        cansada..."
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "aguanta un poco m\xE1s. en nada saldremos de aqui, como tu querias.
        continuemos."
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: es verdad... vamos...
