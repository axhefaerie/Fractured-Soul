--- !u!114 &1032586640
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1032586638}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 506644fc09057a34db0dd9092fc10303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "la reliquia que nos quedaba y la salida de la cueva est\xE1n justo delante"
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: por fin... estoy agotada...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pero estas cansada por una buena causa, piensalo.
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "hemos conseguido recoger las reliquias y las algunas esencias para los
        se\xF1ores ojos"
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "y aparte, hemos pasado la cueva y seguimos vivas. \xBFno es lo que quer\xEDas?
        \xBFno te sientes ahora mejor contigo misma?"
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: si... pero a la vez... no se...
    - character:
        name: lillith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ese si me vale. si que ha valido la pena los combates. ahora salgamos
        de aqui.
