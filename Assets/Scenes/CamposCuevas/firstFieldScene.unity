--- !u!114 &1678738759
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1678738757}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 506644fc09057a34db0dd9092fc10303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "aura... \xBFestas bien?"
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: .....
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: mmmm...... si. o eso creo.
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: vale. bien. tenemos que movernos.
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "pero... \xBFdonde estamos?\xBFcomo hemos llegado aqui?"
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: no se... eso de igual ahora. vamos a ver si hay alguien por aqui cerca
        que nos pueda ayudar.
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: se que por el camino de arriba hay una cueva deshabitada que lleva a
        otro lugar...
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: emm... vale... supongo que no hay mejor plan...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: miremos primero por aqui y luego ya cruzamos la cueva para ver a donde
        lleva...
