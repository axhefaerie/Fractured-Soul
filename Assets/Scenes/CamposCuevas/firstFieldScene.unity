--- !u!114 &699439904
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 699439896}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 506644fc09057a34db0dd9092fc10303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "hola... s\xE9 qui\xE9n eres... eres aura..."
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "eemmm... si... \xBFme conoces de algo?"
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: si... digamos que por este mundo eres muy... conocida...
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "aunque nunca pens\xE9 que llegar\xEDa a verte de verdad...."
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "\xBFpor este mundo? \xBFque sitio es este? "
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "creo que tu mejor que nadie deber\xEDa saberlo...."
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pues no.... no tengo ni idea...
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: 'hagamos un trato. necesito tres reliquias que hay perdidas en la cueva
        que hay al norte. '
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "traemelas y te contar\xE9 lo que se acerca de este sitio."
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: vale... lo hare...
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: 'pues venga, muevete que no tengo todo el dia. '
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: 'eso ultimo sobraba... '
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: no se lo tengas mucho en cuenta... parece un ojo con mucho estres encima...
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "vale... vale... te har\xE9 caso..."
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "\xA1perfecto! pues vamos."
