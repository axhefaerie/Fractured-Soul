  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 506644fc09057a34db0dd9092fc10303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ....
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: .........
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: .............oh.... no te habia visto
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: aura...  hazme un favor...
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "\xBFtambi\xE9n me conoces? \xBFde qu\xE9?"
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: no tengo tiempo para contestar eso... tu ve a esa cuevita bonita que
        esta por ese camino de ahi
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "y alli te encontrar\xE1s, aparte de monstruos y cosas sin importancia,
        unas esencias preciosas..."
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: traeme todas las que puedas... mejor dicho... todas. las. que. haya.
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "pero, \xBFpor que no vas tu?\xBFpor que tengo que ir yo?"
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: 'no ves que estoy ocupado aqui, ya estoy perdiendo mucho tiempo contigo. '
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: asi que vete ya que me estas haciendo perder mucho el tiempo....
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: y espero verte bien pronto con un monton de esencias para mi. como no
        me las traigas.....
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pero...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: 'aura, vamos a tener que ir a la cueva de todos modos. '
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ir recogiendo las esencias que veamos no nos va a perjudicar mucho.
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ya... vale... pero...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "pues venga, \xA1vamos!"
