--- !u!114 &137620052
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 137620050}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 506644fc09057a34db0dd9092fc10303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ....
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ........
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: .......oh ... te habia visto salir de la cueva... estaba esperando con
        ansias que vinieras para que me des las esencias...
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: si...si... toma... aqui tienes
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: 'no se si habran sido todas las que habia ahi dento pero me sirven... '
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: y ahora deja de hablarme, estas haciendo que pierda el tiempo...
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "pero...\xBFno me vas a agradecer ni nada?"
    - character:
        name: ojeton
        icon: {fileID: 1011953355, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: veo eso como una perdida de tiempo. ahora deja de molestar....
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pero...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: aura... vamonos
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: '... vale

'
