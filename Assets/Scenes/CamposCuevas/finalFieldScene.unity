--- !u!114 &2030551350
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2030551348}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 506644fc09057a34db0dd9092fc10303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "emmm... \xBFahora que hacemos?"
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: hay que continuar.
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "pero... \xBFcontinuar a donde?"
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: continuar este camino, hay que ir por el agujero de delante. hay que
        seguir...
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pero... no se... diria que me encuentro cansada...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "\xBFno querias saber la verdad de este mundo? "
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: si si... quiero saberlo...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pues para eso hay que continuar, aunque te pueda doler o algo...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "eso compensa cumplir tu objetivo, \xBFno?"
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ...si...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pues a seguir.
