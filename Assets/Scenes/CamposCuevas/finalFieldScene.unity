--- !u!114 &1579333366
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1579333364}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 506644fc09057a34db0dd9092fc10303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: oh.. hola de nuevo... aura
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: no esperaba que pudieses sobrevivir a los monstruos de esa cueva, pero
        esa parte me da igual
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "\xBFtienes entonces las reliquias que te pedi?"
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "si...si....las reliquias las tengo, pero, \xBFcomo habeis llegado aqui?"
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: eso da igual. muy bien, dame las reliquias... si si... muy bien
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "y entonces, \xBFme puedes decir que es este lugar?"
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: bueno... te puedo decir lo que se...
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: .......... la verdad es que tampoco se que lugar es este
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: 'pero... hicimos un trato... '
    - character:
        name: ojete
        icon: {fileID: -1532374961, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: y yo te he dado mi parte... te he dicho lo que se...
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ....
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "aura dejalo. al menos, \xBFno te sientes un poco mejor contigo por haberle
        ayudado?"
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: pero... pasar la cueva ha sido dificil para mi, y los monstruos me han
        dado varias veces...
    - character:
        name: lilith
        icon: {fileID: -229694047, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: "pero eso da igual, ha sido para un bien mayor, \xBFentiendes?"
    - character:
        name: aura
        icon: {fileID: 1848664192, guid: 8be4195ec3cca8942b14b64e4b17b15b, type: 3}
      line: ....mhm... supongo...
